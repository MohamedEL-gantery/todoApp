{
  "expo": {
    "name": "Task Management",
    "slug": "task-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskmanagement",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Task Management to access your camera for your profile picture.",
        "NSLocationWhenInUseUsageDescription": "Allow Task Management to use your location in the header.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mohamedelgantery.taskmanagement"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#267138",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.mohamedelgantery.taskmanagement",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#267138",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Task Management to use your location in the header."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Task Management to access your camera for your profile picture.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#267138"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ca76fbe7-8b1f-4125-9457-e8781dc8f91c"
      }
    },
    "owner": "mohamedelgantery",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca76fbe7-8b1f-4125-9457-e8781dc8f91c"
    }
  }
}
