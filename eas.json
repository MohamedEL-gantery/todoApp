{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://todo-app-api-git-main-mohamedel-ganterys-projects.vercel.app/api/v1/"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://todo-app-api-git-main-mohamedel-ganterys-projects.vercel.app/api/v1/"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://todo-app-api-git-main-mohamedel-ganterys-projects.vercel.app/api/v1/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
